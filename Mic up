-- Settings
local spinSpeed = 9999999 -- Degrees per second
local spinning = false

-- Function to toggle spinning
local function toggleSpin()
	spinning = not spinning
end

-- Bind toggle to the "T" key
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.T then
		toggleSpin()
	end
end)

-- Rotation logic
RunService.RenderStepped:Connect(function(dt)
	if spinning and rootPart then
		local angle = spinSpeed * dt
		rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(angle), 0)
	end
end)

   end,
})

